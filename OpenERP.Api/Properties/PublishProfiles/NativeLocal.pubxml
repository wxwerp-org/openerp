<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishDir>bin\NativeLocal\$(RuntimeIdentifier)\</PublishDir>
  </PropertyGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="OpenERP.NativeLocal" Value="true" />
  </ItemGroup>

  <Target Name="CollectNativeLocalWeb" BeforeTargets="ComputeFilesToPublish">
    <Exec WorkingDirectory="../OpenERP.Web" Command="pnpm build" />
    <ItemGroup>
      <_NativeWeb Include="../OpenERP.Web/dist/**/*" />
      <ResolvedFileToPublish Include="@(_NativeWeb)" RelativePath="wwwroot/%(_NativeWeb.RecursiveDir)%(_NativeWeb.Filename)%(_NativeWeb.Extension)" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
