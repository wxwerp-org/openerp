<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifiers>linux-x64</RuntimeIdentifiers>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- CI 在 API 构建步骤注入版本信息；默认 0.1.0-dev。SDK 仍会追加 +<sha>，由 /api/about 剥离。 -->
  <PropertyGroup>
    <InformationalVersion Condition="'$(OPENERP_BUILD_VERSION)' != ''">$(OPENERP_BUILD_VERSION)</InformationalVersion>
    <InformationalVersion Condition="'$(OPENERP_BUILD_VERSION)' == ''">0.1.0-dev</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../OpenERP.Persistence/OpenERP.Persistence.csproj" />
    <ProjectReference Include="../OpenERP.Migrations.PostgreSQL/OpenERP.Migrations.PostgreSQL.csproj" />
    <ProjectReference Include="../OpenERP.Migrations.Sqlite/OpenERP.Migrations.Sqlite.csproj" />
    <InternalsVisibleTo Include="OpenERP.Api.Tests" />
    <ProjectReference Include="../OpenERP.Core/OpenERP.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" Version="4.0.103.4" />
    <ProjectReference Include="../OpenERP.ServiceDefaults/OpenERP.ServiceDefaults.csproj" />
    <PackageReference Include="Aspire.Npgsql.EntityFrameworkCore.PostgreSQL" Version="13.6.5" />
    <PackageReference Include="Aspire.StackExchange.Redis.DistributedCaching" Version="17.0.0" />
    <PackageReference Include="Mapster" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.15" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Caching.Hybrid" Version="10.11.1" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.4" />
    <PackageReference Include="RokyZevon.OpResult" Version="0.3.0" />
    <!-- EF 迁移包使用 10.x 设计时依赖，API 发布目录无需携带这些程序集。 -->
    <PackageReference Include="System.CodeDom" Version="10.0.15" Publish="false" />
    <PackageReference Include="System.Composition" Version="10.0.15" Publish="false" />
  </ItemGroup>

  <!-- 提交与构建时间单独注入，避免依赖 SDK 自动追加的版本元数据。 -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>OpenERP.Commit</_Parameter1>
      <_Parameter2>$(OPENERP_BUILD_COMMIT)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>OpenERP.BuildTime</_Parameter1>
      <_Parameter2>$(OPENERP_BUILD_TIME)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
