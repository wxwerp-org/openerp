:{$PORT:5000} {
	root * /srv

	@api path /api /api/*
	handle @api {
		reverse_proxy {$API_HTTP:http://api:8080} {
			# 外层反代是唯一客户端且已写入原始协议/客户端地址；原样传给 API。
			header_up X-Forwarded-Proto {http.request.header.X-Forwarded-Proto}
			header_up X-Forwarded-For {http.request.header.X-Forwarded-For}
		}
	}

	@reserved path /health /health/* /alive /alive/* /assets
	handle @reserved {
		respond 404
	}

	@assets path /assets/*
	handle @assets {
		file_server
	}

	@index path /index.html
	handle @index {
		header Cache-Control "no-cache"
		file_server
	}

	@navigation {
		method GET HEAD
		not path_regexp \.[A-Za-z0-9]+$
	}
	handle @navigation {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	handle {
		respond 404
	}
}
