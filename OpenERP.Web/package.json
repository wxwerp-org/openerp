{
  "name": "openerp-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.16.0",
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit",
    "build": "vite build",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier --write --experimental-cli src/ tests/ scripts/ '*.config.{js,ts}' index.html package.json tsconfig.json .prettierrc.json",
    "format:check": "prettier --check --experimental-cli src/ tests/ scripts/ '*.config.{js,ts}' index.html package.json tsconfig.json .prettierrc.json",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "visual:capture": "VISUAL_PROBE=1 playwright test tests/e2e/visual-probe.spec.ts",
    "visual:compare": "node scripts/compare-visual.mjs"
  },
  "dependencies": {
    "@microsoft/signalr": "^11.0.0",
    "vue": "3.5.45",
    "vue-router": "5.5.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "@vitejs/plugin-vue": "6.0.10",
    "@vitest/eslint-plugin": "1.6.28",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/test-utils": "2.5.1",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-playwright": "2.12.2",
    "eslint-plugin-vue": "10.12.1",
    "globals": "17.14.0",
    "jsdom": "31.0.0",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "vue-tsc": "3.3.14"
  }
}
